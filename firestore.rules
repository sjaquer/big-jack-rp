rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // === FUNCIÓN HELPER ===
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // === PRODUCTOS & INGREDIENTES ===
    match /products/{productId} { allow read, write: if isAuthenticated(); }
    match /ingredients/{ingredientId} { allow read, write: if isAuthenticated(); }
    
    // === VENTAS ===
    match /sales/{saleId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated(); 
      allow delete: if isAuthenticated(); 
      
      match /sale_items/{itemId} { allow read, write: if isAuthenticated(); }
    }

    // === INSIGHTS QUERY (Collection Group) ===
    match /{path=**}/sale_items/{itemId} {
      allow read: if isAuthenticated();
    }
    
    // === PEDIDOS & CLIENTES ===
    match /online_orders/{orderId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }
    
    match /customers/{customerId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }
    
    // === VARIOS ===
    match /cash_flows/{entryId} { allow read, write: if isAuthenticated(); }
    match /sunat_series/{seriesId} { allow read, write: if isAuthenticated(); }
    match /other_items/{itemId} { allow read, write: if isAuthenticated(); }
    match /inventory_items/{itemId} { allow read, write: if isAuthenticated(); }
    
    match /inventory_movements/{movementId} {
      allow read, create, update, delete: if isAuthenticated();
    }
    
    // === CAJA CHICA (Requerido para POS) ===
    match /cash_registers/{registerId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }
    
    match /cash_movements/{movementId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
