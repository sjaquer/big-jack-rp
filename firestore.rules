
/**
 * This ruleset is for the "Big Jack Manager" application.
 * It's designed for an internal management tool where an authenticated
 * manager has broad access, while the system itself (e.g., POS) can
 * perform specific write operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------
    // Helper Functions
    // --------------------------------

    /**
     * Checks if the user is authenticated (logged in).
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches a given userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the user has a 'Manager' role via their email.
     * This provides admin-level access across the app.
     * For production, it's better to use custom claims.
     */
    function isManager() {
      // IMPORTANT: Login with this exact email to get manager access.
      return isSignedIn() && request.auth.token.email == "bigjack@gmail.com";
    }

    // --------------------------------
    // Customer & Order Data Rules
    // --------------------------------

    /**
     * Customer profiles are only used for online orders.
     * Only the manager can list/view them for administrative purposes.
     * A customer can only be created as part of an online order process.
     */
    match /customers/{customerId} {
      allow get: if isManager();
      allow list: if isManager();
      allow create: if isSignedIn(); // Allow creation for new online orders
      allow update: if isManager();
      allow delete: if isManager();
    }

    /**
     * Online orders can be viewed by the manager.
     * Any authenticated system (like the POS or a future online portal) can create them.
     * Only the manager can update or delete them.
     */
    match /online_orders/{onlineOrderId} {
      allow read: if isManager();
      allow create: if isSignedIn();
      allow update: if isManager();
      allow delete: if isManager();
    }

    // --------------------------------
    // Business & Operational Data Rules
    // (Manager has full access, general system has read/specific write)
    // --------------------------------

    /**
     * All business-critical data like products, ingredients, inventory, and suppliers
     * should be readable by any authenticated employee/system.
     * However, only the manager should be able to create, modify, or delete these records
     * to maintain data integrity. The POS system will only UPDATE stock quantities.
     */
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isManager();
      // Allow updates for managers OR for stock changes by any signed-in user (POS)
      allow update: if isManager() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']));
      allow delete: if isManager();
    }

    match /ingredients/{ingredientId} {
      allow read: if isSignedIn();
      allow create: if isManager();
       // Allow updates for managers OR for stock changes by any signed-in user (POS)
      allow update: if isManager() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']));
      allow delete: if isManager();
    }

    match /inventory_items/{inventoryItemId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    /**
     * Cashier profiles. Reference data, only manager can edit.
     */
    match /cashiers/{cashierId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    /**
     * Sales data. This is critical financial data.
     * The POS system can create sales records.
     * For data integrity, updates and deletes are disallowed from the client.
     * Only the manager can read the full list of sales for reporting.
     */
    match /sales/{saleId} {
      allow get: if isManager();
      allow list: if isManager();
      allow create: if isSignedIn(); // POS creates sales
      allow update: if false;
      allow delete: if false;

      /**
       * Items within a sale.
       */
      match /sale_items/{saleItemId} {
        allow get: if isManager();
        allow list: if isManager();
        allow create: if isSignedIn(); // POS creates sale items
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
