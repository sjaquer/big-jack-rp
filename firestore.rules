
/**
 * This ruleset is for the "Big Jack Manager" application.
 * It's designed for an internal management tool where authenticated
 * users (employees/managers) have broad access, while still protecting
 * sensitive customer data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------
    // Helper Functions
    // --------------------------------

    /**
     * Checks if the user is authenticated (logged in).
     * This is the base for all other permissions.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches a given userId.
     * This is used for ownership-based security.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Confirms a document exists and the user is the owner,
     * for update/delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Checks if the user has a 'Manager' role via their email.
     * This provides admin-level access across the app.
     * For production, it's better to use custom claims.
     */
    function isManager() {
      return isSignedIn() && request.auth.token.email == "bigjackpe@gmail.com";
    }

    // --------------------------------
    // Customer & Order Data Rules
    // --------------------------------

    /**
     * Customer profiles. Only the owner can manage their own profile.
     * A Manager can view and list all customer profiles for support.
     */
    match /customers/{customerId} {
      allow get: if isOwner(customerId) || isManager();
      allow list: if isManager(); // Only managers can list all customers
      allow create: if isOwner(customerId);
      allow update: if isExistingOwner(customerId);
      allow delete: if isExistingOwner(customerId);
    }

    /**
     * Online orders. Customers can see their own orders.
     * Managers can see and manage all orders.
     */
    match /online_orders/{onlineOrderId} {
      allow get: if (isSignedIn() && isOwner(resource.data.customerId)) || isManager();
      allow list: if isManager(); // Only managers can see the full order list
      allow create: if isSignedIn(); // Any logged-in user (incl. POS system) can create
      allow update: if isManager(); // Only managers can change order status
      allow delete: if isManager();
    }

    // --------------------------------
    // Business & Operational Data Rules
    // (Broadly accessible to authenticated staff)
    // --------------------------------

    /**
     * Products, Ingredients, Inventory, Suppliers.
     * Any authenticated user (staff) can read this data.
     * Any authenticated user (staff) can also write, to allow POS stock updates.
     */
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /ingredients/{ingredientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /inventory_items/{inventoryItemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /**
     * Cashier profiles. Reference data.
     */
    match /cashiers/{cashierId} {
      allow read: if isSignedIn();
      allow write: if isManager(); // Only managers can add/edit cashier info
    }

    /**
     * Sales data. This is created by the POS.
     * For security, updates and deletes from the client are disabled.
     */
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // POS creates sales
      allow update: if false;
      allow delete: if false;

      /**
       * Items within a sale.
       */
      match /sale_items/{saleItemId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn(); // POS creates sale items
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
