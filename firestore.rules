rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    match /ingredients/{ingredientId} {
      allow read, write: if isAuthenticated();
    }

    match /inventory_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /inventory_movements/{movementId} {
      allow read, write: if isAuthenticated();
    }

    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    match /online_orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    match /sales/{saleId} {
      allow read, write: if isAuthenticated();

      match /sale_items/{itemId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /cash_flows/{entryId} {
      allow read, write: if isAuthenticated();
    }

    match /cash_registers/{registerId} {
      allow read, write: if isAuthenticated();
    }

    match /cash_movements/{movementId} {
      allow read, write: if isAuthenticated();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAuthenticated();
    }

    // Denegar cualquier colección no contemplada explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}